{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Takes a screenshot of the game when you leave a world or server, and displays it when you rejoin it. Unofficial continuation of Seamless Loading Screen by Minenash.",
  "authors": [
    "Minenash",
    "Kismeria"
  ],
  "contributors": [
    "Dragon-Seeker"
  ],
  "contact": {
    "sources": "https://github.com/Minenash/Seamless-Loading-Screen"
  },
  "license": "MIT",
  "icon": "assets/seamless_loading_screen/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.minenash.seamless_loading_screen.fabric.SeamlessLoadingScreenFabric"
    ],
    "modmenu": [
      "com.minenash.seamless_loading_screen.fabric.config.ModMenuEntryPoint"
    ]
  },
  "mixins": [
    "seamless_loading_screen.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "yet_another_config_lib_v3": "*"
  },
  "conflicts": {
    "wynntils": "*"
  }
}
